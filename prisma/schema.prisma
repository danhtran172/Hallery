// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Shadow schema: Hallery-only metadata layer.
// Never mirrors Notion structure back into Notion — Hallery only reads
// Notion data/values and stores its own display/layout metadata here,
// keyed by the Notion database/property IDs it describes.

model Workspace {
  id           String   @id @default(cuid())
  name         String
  notionBotId  String?
  accessToken  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  galleries    Gallery[]
}

model Gallery {
  id                 String    @id @default(cuid())
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  notionDatabaseId   String
  notionDataSourceId String
  name               String
  icon               String?
  description        String?
  sortOrder          Int       @default(0)
  displayConfig      String    @default("{}")

  /// Added by following another gallery's relation rather than picked by hand. These stay
  /// out of the dashboard — a database only reachable as someone else's relation target is
  /// noise there — and surface through the relation popup on the gallery that reached it.
  /// Picking one by hand later clears the flag and promotes it to a normal gallery.
  autoAdded          Boolean   @default(false)

  parentGalleryId    String?
  parentGallery      Gallery?  @relation("SubGalleries", fields: [parentGalleryId], references: [id])
  subGalleries       Gallery[] @relation("SubGalleries")

  propertyConfigs    PropertyConfig[]
  categoryAxes       CategoryAxis[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([workspaceId, notionDataSourceId])
}

/// Remembers the first content image found in a Notion page, so the Gallery doesn't
/// re-crawl every page's blocks on each render. Notion's file URLs are signed and
/// short-lived, hence expiresAt — a miss just costs one API call to refresh.
model PageImageCache {
  notionPageId String   @id
  imageUrl     String?
  expiresAt    DateTime
  /// Filename of the downloaded copy under the cover cache directory. Notion's own URLs
  /// are signed and die within the hour, so caching one buys less than a day; a local
  /// copy is what actually keeps a cover on screen without re-asking Notion.
  storedFile   String?
  checkedAt    DateTime @updatedAt
}

/// Where a card's cover image sits inside its frame, nudged by Ctrl-dragging the card.
/// Percentages, matching CSS background-position.
model CoverPosition {
  id           String   @id @default(cuid())
  galleryId    String
  notionPageId String
  posX         Float    @default(50)
  posY         Float    @default(50)
  updatedAt    DateTime @updatedAt

  @@unique([galleryId, notionPageId])
}

/// A property used to sort items into categories — Series, Genre, and so on.
/// Select-like sources cost nothing to browse because their values already ride along
/// with the page data; relation sources need one request to list the linked items.
model CategoryAxis {
  id                 String   @id @default(cuid())
  galleryId          String
  gallery            Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  notionPropertyId   String
  notionPropertyName String
  sourceType         String
  displayLabel       String?
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([galleryId, notionPropertyId])
}

model PropertyConfig {
  id                 String   @id @default(cuid())
  galleryId          String
  gallery            Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  notionPropertyId   String
  notionPropertyName String
  notionPropertyType String
  /// What a formula or rollup actually evaluates to ("number" | "string" | "date" |
  /// "boolean" | "array"). Notion's schema only exposes the expression, never the
  /// output type — it surfaces solely on a page's value — so this is detected from a
  /// sampled page. Null means not determined yet. Unused for other property types.
  resolvedType       String?
  displayConfig      String   @default("{}")
  /// The same settings again for the Card Detail, which formats its properties
  /// independently of the gallery card — a score can be stars on a thumbnail and a plain
  /// number on the page. Empty means untouched, and the detail borrows `displayConfig`;
  /// the editor's sync button fills this in by copying it across.
  detailDisplayConfig String  @default("")
  sortOrder          Int      @default(0)
  hidden             Boolean  @default(false)
  isMissing          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([galleryId, notionPropertyId])
}
